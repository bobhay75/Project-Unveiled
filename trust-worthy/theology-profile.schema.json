{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bobsome1.com/trust-worthy/schema/theology-profile-v0.1.json",
  "title": "Trust-Worthy Theology Profile v0.1",
  "type": "object",
  "required": ["member_id", "display_name", "positions", "updated_at"],
  "properties": {
    "member_id": {"type": "string", "pattern": "^TW-MEMBER-[A-Za-z0-9_-]+$"},
    "display_name": {"type": "string", "minLength": 1},
    "bio": {"type": ["string", "null"]},
    "profile_visibility": {"type": "string", "enum": ["public", "private"]},
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["position_id", "topic", "p", "stance", "revision_history"],
        "properties": {
          "position_id": {"type": "string"},
          "topic": {"type": "string"},
          "p": {"type": "string", "minLength": 1},
          "not_p": {"type": ["string", "null"]},
          "stance": {"type": "string", "enum": ["holds-p", "holds-not-p", "unresolved", "not-investigated"]},
          "member_explanation": {"type": ["string", "null"]},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["evidence_id", "position"],
              "properties": {
                "evidence_id": {"type": "string"},
                "position": {"type": "string", "enum": ["supports-p", "supports-not-p", "context"]},
                "citation": {"type": ["string", "null"]},
                "url": {"type": ["string", "null"]},
                "note": {"type": ["string", "null"]}
              }
            }
          },
          "linked_truth_trials": {"type": "array", "items": {"type": "string", "pattern": "^TW-CASE-[0-9]{6}$"}},
          "open_challenges": {"type": "array", "items": {"type": "string"}},
          "resolved_challenges": {"type": "array", "items": {"type": "string"}},
          "revision_history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["date", "from", "to", "reason"],
              "properties": {
                "date": {"type": "string"},
                "from": {"type": "string"},
                "to": {"type": "string"},
                "reason": {"type": "string"},
                "truth_trial_id": {"type": ["string", "null"]},
                "challenge_id": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    },
    "contributions": {
      "type": "object",
      "properties": {
        "primary_sources_contributed": {"type": "integer", "minimum": 0},
        "successful_challenges": {"type": "integer", "minimum": 0},
        "corrections_accepted": {"type": "integer", "minimum": 0},
        "truth_trials_participated": {"type": "integer", "minimum": 0}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}