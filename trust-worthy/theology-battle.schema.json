{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bobsome1.com/trust-worthy/schema/theology-battle-v0.1.json",
  "title": "Trust-Worthy Theology Battle v0.1",
  "type": "object",
  "required": ["battle_id", "p", "not_p", "participant_a", "participant_b", "status", "turns", "created_at", "updated_at"],
  "properties": {
    "battle_id": {"type": "string", "pattern": "^TW-BATTLE-[0-9]{6}$"},
    "p": {"type": "string", "minLength": 1},
    "not_p": {"type": "string", "minLength": 1},
    "participant_a": {"type": "string"},
    "participant_b": {"type": "string"},
    "status": {"type": "string", "enum": ["invited", "accepted", "live", "researching", "complete", "reopened"]},
    "current_side": {"type": ["string", "null"], "enum": ["a", "b", null]},
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["turn_number", "side", "position", "submission", "trust_research", "scores"],
        "properties": {
          "turn_number": {"type": "integer", "minimum": 1},
          "side": {"type": "string", "enum": ["a", "b"]},
          "position": {"type": "string", "enum": ["supports-p", "supports-not-p"]},
          "submission": {"type": "string"},
          "submitted_sources": {"type": "array", "items": {"type": "object"}},
          "trust_research": {
            "type": "object",
            "required": ["fresh_search_performed", "summary"],
            "properties": {
              "fresh_search_performed": {"const": true},
              "summary": {"type": "string"},
              "independent_sources": {"type": "array", "items": {"type": "object"}},
              "source_lineage": {"type": "array", "items": {"type": "object"}},
              "counterevidence": {"type": "array", "items": {"type": "object"}},
              "power_incentive_audit": {"type": "array", "items": {"type": "object"}},
              "reasoning_notes": {"type": "array", "items": {"type": "string"}}
            }
          },
          "scores": {
            "type": "object",
            "required": ["provenance", "proximity", "independence", "corroboration", "context", "language_accuracy", "logical_force", "adversarial_survival", "power_resilience"],
            "properties": {
              "provenance": {"type": "integer", "minimum": 0, "maximum": 5},
              "proximity": {"type": "integer", "minimum": 0, "maximum": 5},
              "independence": {"type": "integer", "minimum": 0, "maximum": 5},
              "corroboration": {"type": "integer", "minimum": 0, "maximum": 5},
              "context": {"type": "integer", "minimum": 0, "maximum": 5},
              "language_accuracy": {"type": "integer", "minimum": 0, "maximum": 5},
              "logical_force": {"type": "integer", "minimum": 0, "maximum": 5},
              "adversarial_survival": {"type": "integer", "minimum": 0, "maximum": 5},
              "power_resilience": {"type": "integer", "minimum": 0, "maximum": 5}
            }
          },
          "score_explanation": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "passes": {
      "type": "object",
      "properties": {
        "a": {"type": "boolean"},
        "b": {"type": "boolean"}
      }
    },
    "final_review": {
      "type": ["object", "null"],
      "properties": {
        "fresh_whole_case_research": {"type": "boolean"},
        "source_lineage_deduped": {"type": "boolean"},
        "leader_attacked": {"type": "boolean"},
        "power_incentive_audit": {"type": "array", "items": {"type": "object"}},
        "facts_considered": {"type": "array", "items": {"type": "string"}},
        "alternative_explanations": {"type": "array", "items": {"type": "string"}},
        "epistemic_assessment": {"type": "string", "enum": ["supports-p", "leans-p", "insufficient", "leans-not-p", "supports-not-p"]},
        "battle_winner": {"type": ["string", "null"], "enum": ["a", "b", "tie", null]},
        "rationale": {"type": "string"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}