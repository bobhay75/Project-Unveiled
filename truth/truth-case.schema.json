{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bobsome1.com/truth/truth-case-v0.2.schema.json",
  "title": "Trust-Worthy Truth Trial Record v0.2",
  "description": "A public, versioned evidence assessment. Publication state and evidentiary maturity are separate so a provisional record cannot masquerade as a completed finding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "version",
    "status",
    "mode",
    "title",
    "description",
    "question",
    "claim",
    "scope",
    "propositions",
    "finding",
    "sources",
    "evidence_for_p",
    "evidence_for_not_p",
    "alternative_hypotheses",
    "logic_audit",
    "adversarial_review",
    "christ_consistency",
    "epistemic_limits",
    "revision_history",
    "public_url",
    "challenge_endpoint",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^TW-CLAIM-[0-9]{6}$"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["open", "investigating", "provisional", "published", "challenged", "reopened", "archived"]},
    "mode": {"type": "string", "enum": ["historical", "theology", "textual", "scientific", "public-claim", "mixed"]},
    "title": {"type": "string", "minLength": 5},
    "description": {"type": "string", "minLength": 20},
    "question": {"type": "string", "minLength": 5},
    "claim": {"type": "string", "minLength": 5},
    "scope": {"type": "string", "minLength": 20},
    "propositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposition_id", "p", "not_p", "scope", "epistemic_assessment"],
        "properties": {
          "proposition_id": {"type": "string", "pattern": "^P[0-9]+$"},
          "p": {"type": "string", "minLength": 1},
          "not_p": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 10},
          "epistemic_assessment": {"$ref": "#/$defs/assessment"}
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epistemic_assessment", "summary", "strongest_objection", "what_would_change_it", "maturity", "destination"],
      "properties": {
        "epistemic_assessment": {"$ref": "#/$defs/assessment"},
        "summary": {"type": "string", "minLength": 20},
        "strongest_objection": {"type": "string", "minLength": 20},
        "what_would_change_it": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
        "maturity": {"type": "string", "enum": ["open", "provisional", "adversarially-reviewed", "mature"]},
        "destination": {"type": "string", "enum": ["unveiled", "bunk-book", "mystery-book", "none"]}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "source_type", "position", "citation", "url", "provenance", "lineage_parent", "independent", "authenticity_or_dating_dispute", "limitations"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^S[0-9]+$"},
          "title": {"type": "string", "minLength": 2},
          "source_type": {"type": "string", "enum": ["primary-text", "manuscript", "artifact", "data", "historical-study", "scholarship", "reference", "context"]},
          "position": {"type": "string", "enum": ["supports-p", "supports-not-p", "counterevidence", "context", "neutral"]},
          "citation": {"type": "string", "minLength": 2},
          "url": {"type": ["string", "null"], "format": "uri"},
          "provenance": {"type": "string", "minLength": 10},
          "lineage_parent": {"type": ["string", "null"]},
          "independent": {"type": ["boolean", "null"]},
          "authenticity_or_dating_dispute": {"type": ["string", "null"]},
          "limitations": {"type": "string", "minLength": 5}
        }
      }
    },
    "evidence_for_p": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "evidence_for_not_p": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "alternative_hypotheses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "logic_audit": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "adversarial_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed", "strongest_case", "response", "unresolved"],
      "properties": {
        "performed": {"type": "boolean"},
        "strongest_case": {"type": "string", "minLength": 10},
        "response": {"type": "string", "minLength": 10},
        "unresolved": {"type": "array", "items": {"type": "string", "minLength": 5}}
      }
    },
    "christ_consistency": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["summary", "cautions"],
      "properties": {
        "summary": {"type": "string", "minLength": 20},
        "cautions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}}
      }
    },
    "epistemic_limits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "revision_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "date", "change"],
        "properties": {
          "version": {"type": "integer", "minimum": 1},
          "date": {"type": "string", "format": "date"},
          "change": {"type": "string", "minLength": 5}
        }
      }
    },
    "public_url": {"type": "string", "format": "uri", "pattern": "^https://bobsome1\\.com/truth/"},
    "challenge_endpoint": {"type": "string", "format": "uri", "const": "https://bobsome1.com/truth/challenge-submit.php"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "assessment": {
      "type": "string",
      "enum": ["supports-p", "leans-p", "insufficient", "leans-not-p", "supports-not-p", "not-yet-investigated"]
    }
  }
}
